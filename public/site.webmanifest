{
  "name": "Polamuse — Made by you. Felt by them.",
  "short_name": "Polamuse",
  "description": "Create polaroid frames, instant film photos, and aesthetic photo cards with Spotify codes and vintage filters.",
  "start_url": "/editor",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "background_color": "#F5F0EB",
  "theme_color": "#F5F0EB",
  "orientation": "portrait-primary",
  "categories": ["photo", "utilities", "lifestyle"],
  "lang": "en",
  "icons": [
    { "src": "/favicon-16.png",       "sizes": "16x16",   "type": "image/png" },
    { "src": "/favicon-32.png",       "sizes": "32x32",   "type": "image/png" },
    { "src": "/apple-touch-icon.png", "sizes": "180x180", "type": "image/png" },
    { "src": "/icon-192.png",         "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-192.png",         "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icon-512.png",         "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png",         "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "New Design",
      "short_name": "Create",
      "description": "Start a fresh polaroid design",
      "url": "/editor",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "My Designs",
      "short_name": "Saved",
      "description": "View your saved designs",
      "url": "/designs",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Booth Mode",
      "short_name": "Booth",
      "description": "Take a 4-shot film strip",
      "url": "/booth",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    }
  ],
  "related_applications": [],
  "prefer_related_applications": false
}
